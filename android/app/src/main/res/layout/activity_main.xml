<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <Button
            android:id="@+id/btnClose"
            style="@style/AegisButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Close app" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.08"
            android:text="AEGIS · NATIVE"
            android:textColor="@color/muted"
            android:textSize="12sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="This phone"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Build 4 — Close app is always at the top. Swipe back also exits."
            android:textColor="@color/muted"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/accessTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aegis needs All files access"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/accessCopy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Android will open the All files screen. Turn Aegis on, then swipe back."
                android:textColor="@color/muted"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnAllow"
                style="@style/AegisButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Allow all files" />
            <Button
                android:id="@+id/btnScan"
                style="@style/AegisButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Scan allowed storage"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnDeep"
                style="@style/AegisButton.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Deep scan"
                android:visibility="gone" />
            <Button
                android:id="@+id/btnStop"
                style="@style/AegisButton.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Stop scan"
                android:visibility="gone" />
            <ProgressBar
                android:id="@+id/bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progressTint="@color/colorPrimary"
                android:visibility="gone" />
            <TextView
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/findingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/findingsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Findings"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/findings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <Button
                android:id="@+id/btnClear"
                style="@style/AegisButton.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Clear results" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
